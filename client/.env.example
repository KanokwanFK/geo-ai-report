# Backend API URL
# For Development (local backend)
VITE_API_BASE_URL=http://localhost:3003

# For Production (deployed backend)
# VITE_API_BASE_URL=https://your-backend.onrender.com

# N8N Webhook URL
# For Development (local n8n)
# VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/YOUR-WEBHOOK-ID/chat

# For Production (n8n cloud, ngrok, or deployed n8n)
# VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/YOUR-WEBHOOK-ID/chat
